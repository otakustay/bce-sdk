{
  "name": "@otakustay/bce-sdk",
  "version": "2.0.0",
  "description": "Yet another Baidu Cloud SDK",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/shared/index.d.ts",
      "default": "./dist/shared/index.js"
    },
    "./bos": {
      "types": "./dist/bos/index.d.ts",
      "default": "./dist/bos/index.js"
    },
    "./bls": {
      "types": "./dist/bls/index.d.ts",
      "default": "./dist/bls/index.js"
    },
    "./sts": {
      "types": "./dist/sts/index.d.ts",
      "default": "./dist/sts/index.js"
    },
    "./cdn": {
      "types": "./dist/cdn/index.d.ts",
      "default": "./dist/cdn/index.js"
    },
    "./cfc": {
      "types": "./dist/cfc/index.d.ts",
      "default": "./dist/cfc/index.js"
    }
  },
  "engines": {
    "node": ">= 22.0.0"
  },
  "scripts": {
    "lint": "oxlint --fix",
    "build": "tsc -p tsconfig.build.json",
    "ci": "npm ci && npm run lint && npm run build",
    "prepare": "husky",
    "prepublishOnly": "npm run ci"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otakustay/bce-sdk.git"
  },
  "keywords": [
    "bce",
    "bos",
    "bls",
    "sts"
  ],
  "author": "otakustay <otakustay@gmail.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/otakustay/bce-sdk/issues"
  },
  "homepage": "https://github.com/otakustay/bce-sdk#readme",
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@commitlint/types": "^20.4.3",
    "@types/node": "^22.0.0",
    "dprint": "^0.52.0",
    "husky": "^9.1.7",
    "oxlint": "^1.51.0",
    "oxlint-tsgolint": "^0.16.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
